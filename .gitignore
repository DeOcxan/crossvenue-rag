# Corpus: the manifest is versioned, the bytes are not.
data/raw/
data/processed/
data/index/
data/cache/

# Eval runs: only the runs the documents cite are committed; each is listed
# below and hashed in results/runs.json by `crossvenue runs-manifest`.
results/*
!results/20260924T200525Z/
!results/20260924T234623Z/
!results/20260925T002151Z/
!results/20260925T003721Z_pool/
!results/20260925T012314Z/
!results/20260925T015715Z/
!results/20260925T024237Z/
!results/20260925T132613Z/
!results/20260925T144223Z/
!results/20260925T175128Z_answers/
!results/20260925T202827Z_answers/
!results/20260925T225850Z_bench/
!results/20260926T000001Z_judged/
!results/20260926T004836Z_judged/
!results/20260926T004851Z_prompts/
!results/20260926T015648Z_power/
!results/20261010T214504Z/
!results/20261010T222553Z/
# The committed runs' file hashes and index_versions (`crossvenue runs-manifest`).
!results/runs.json

# Figures: PNGs are raster copies for print, generated by `make figures`, not referenced by any document.
docs/figures/*.png

# Secrets: any .env variant, except the committed template
.env
.env.*
!.env.example

